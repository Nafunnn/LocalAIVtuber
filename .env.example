# Environment variables for LocalAIVtuber
# Copy this file to .env and fill in your values
# Note: The app reads OLLAMA_API_KEY from system environment, not this file.
# Set it before starting the server:
#   Windows CMD:  set OLLAMA_API_KEY=your_key_here
#   PowerShell:   $env:OLLAMA_API_KEY="your_key_here"

# Ollama Cloud API key (get from https://ollama.com/settings/keys)
OLLAMA_API_KEY=
